# NatureHouse — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# `.env.local` is git-ignored and must NEVER be committed. This `.env.example`
# is safe to commit because it contains no secrets.
# ---------------------------------------------------------------------------

# Together AI API key (required for the concierge chatbot).
# Get one at https://api.together.xyz/settings/api-keys
# Without it, the site still runs and the chatbot returns a friendly fallback.
TOGETHER_API_KEY=

# Chat model used by the concierge (OpenAI-compatible model id on Together AI).
# Default below is a strong, low-cost pick for a guest-facing concierge.
#   meta-llama/Llama-3.3-70B-Instruct-Turbo        ~$0.88 / 1M tokens
# Cheaper alternatives:
#   meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo    ~$0.18 / 1M tokens
#   Qwen/Qwen2.5-7B-Instruct-Turbo                 very cheap
# Free (rate-limited) option for local testing:
#   meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Firebase web config (Firebase console > Project settings > Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
