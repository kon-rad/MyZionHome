# NatureHouse: environment template
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit it.
#   cp .env.example .env.local
# On Vercel, add the same names under Project > Settings > Environment Variables.

# --- AI concierge (Together AI) ---------------------------------------------
# Where: https://api.together.xyz/settings/api-keys
# Without it the site still runs and the chatbot returns a friendly fallback.
TOGETHER_API_KEY=
# Any OpenAI-compatible chat model id on Together AI. Cheaper: meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- Availability sync (Airbnb calendar) --------------------------------------
# Where: Airbnb > Calendar > Availability settings > Connect calendars > Export calendar.
# Copy the .ics link. It has availability only (no prices) and anyone holding the
# link can read it, so keep it secret. Without it /availability shows a fallback.
AIRBNB_ICAL_URL=

# --- Firebase (Firestore) ------------------------------------------------------
# Where: Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# These identify your project and are safe to expose; access is controlled by
# firestore.rules (deny-all by default).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
